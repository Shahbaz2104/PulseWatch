# --- PulseWatch backend configuration ---
# Copy to .env and adjust as needed. Never commit real secrets.

# HTTP server bind address
HOST=127.0.0.1
PORT=3000

# SQLite database URL. Parent directories are created automatically on startup.
DATABASE_URL=sqlite://./data/pulsewatch.db

# Optional: serve a built frontend (frontend/dist) from the backend with SPA
# fallback, so one process serves both the API and the app. Must be an existing
# directory; unknown /api/* paths still return JSON 404.
# STATIC_DIR=frontend/dist

# Log filter (Rust tracing). Examples: "info", "pulsewatch_backend=debug,tower_http=info"
RUST_LOG=info,pulsewatch_backend=info

# Comma-separated origins allowed by CORS (the Vite dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Monitoring defaults (used for newly created monitors and scheduler tuning) ---
# Default interval between checks per monitor, in seconds (allowed range: 10 - 86400).
DEFAULT_CHECK_INTERVAL_SECONDS=60
# Default per-request timeout, in milliseconds (allowed range: 100 - 60000).
DEFAULT_TIMEOUT_MS=5000
# Default maximum attempts per check, including the first one (allowed range: 1 - 5).
DEFAULT_RETRY_MAX_ATTEMPTS=2
# Default exponential backoff base delay, in milliseconds.
DEFAULT_RETRY_BACKOFF_MS=500
# Maximum backoff delay between attempts, in milliseconds.
DEFAULT_RETRY_BACKOFF_MAX_MS=10000

# Maximum number of HTTP checks that may run at the same time (allowed range: 1 - 256).
MAX_CONCURRENT_CHECKS=16
# Days of check history to keep (allowed range: 7 - 365). The Settings UI can override it.
CHECK_RETENTION_DAYS=90

# IMPORTANT (tests/dev only): when "true", SSRF protections allow private/loopback
# targets so the integration test suite can hit a local mock server.
# Leave unset or "false" in production.
# PULSEWATCH_ALLOW_PRIVATE_TARGETS=true

# --- Admin authentication (required outside demo mode) ---
# Generate the Argon2id hash without leaking the password into shell history:
#   printf '%s\n' "$PASSWORD" | cargo run --bin hash-password
# Paste the single-line output below inside single quotes (dotenvy would
# otherwise treat `$argon2id` as variable interpolation).
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Rotation signs
# every existing session out.
# SESSION_SECRET=
# Set to "true" when the console is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Read-only public demo: disables auth and rejects every mutation. On first
# boot an empty database is seeded with monitors, checks, incidents, and one
# paused monitor. Leave off for any instance whose data must be writable.
DEMO_MODE=false

# --- Alert email (optional) ---
# Webhook alerts work without SMTP. Email alerts require every value below
# (SMTP_USERNAME and SMTP_PASSWORD are optional, but must be set together).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=alerts@example.com
# TLS mode: starttls (default) | implicit | none
# SMTP_TLS=starttls
