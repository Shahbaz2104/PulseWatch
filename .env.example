# --- PulseWatch backend configuration ---
# Copy to .env and adjust as needed. Never commit real secrets.

# HTTP server bind address
HOST=127.0.0.1
PORT=3000

# SQLite database URL. Parent directories are created automatically on startup.
DATABASE_URL=sqlite://./data/pulsewatch.db

# Log filter (Rust tracing). Examples: "info", "pulsewatch_backend=debug,tower_http=info"
RUST_LOG=info,pulsewatch_backend=info

# Comma-separated origins allowed by CORS (the Vite dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Monitoring defaults (used for newly created monitors and scheduler tuning) ---
# Default interval between checks per monitor, in seconds (allowed range: 10 - 86400).
DEFAULT_CHECK_INTERVAL_SECONDS=60
# Default per-request timeout, in milliseconds (allowed range: 100 - 60000).
DEFAULT_TIMEOUT_MS=5000
# Default maximum attempts per check, including the first one (allowed range: 1 - 5).
DEFAULT_RETRY_MAX_ATTEMPTS=2
# Default exponential backoff base delay, in milliseconds.
DEFAULT_RETRY_BACKOFF_MS=500
# Maximum backoff delay between attempts, in milliseconds.
DEFAULT_RETRY_BACKOFF_MAX_MS=10000

# Maximum number of HTTP checks that may run at the same time (allowed range: 1 - 256).
MAX_CONCURRENT_CHECKS=16

# IMPORTANT (tests/dev only): when "true", SSRF protections allow private/loopback
# targets so the integration test suite can hit a local mock server.
# Leave unset or "false" in production.
# PULSEWATCH_ALLOW_PRIVATE_TARGETS=true
